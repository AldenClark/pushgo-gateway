[package]
name = "current500-diagnostic-fixture"
version = "0.0.0"
edition = "2024"
[[bin]]
name = "current500-diagnostic-fixture"
path = "fixture.rs"
[profile.release]
lto = "fat"
codegen-units = 1
panic = "abort"
opt-level = 3
[dependencies]
pushgo-gateway = { path = "__MAINLINE_GATEWAY_SOURCE__" }
clap = { version = "4.6.6", features = ["derive", "env"] }
tokio = { version = "1.53.1", features = ["rt-multi-thread", "macros", "net", "signal", "sync", "time"] }
axum = "0.8.9"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter", "json"] }
serde_json = "1.0.151"
