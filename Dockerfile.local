# syntax=docker/dockerfile:1.6

FROM debian:bookworm AS builder

ARG BINARY_NAME=pushgo-gateway
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config \
    && curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY src ./src

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/target \
    set -eux; \
    . "$HOME/.cargo/env"; \
    cargo build --release -p pushgo-gateway --bin "${BINARY_NAME}"; \
    install -m 0755 "target/release/${BINARY_NAME}" /tmp/pushgo-gateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/pushgo-gateway /usr/local/bin/pushgo-gateway

RUN set -eux; \
    groupadd --system --gid 10001 pushgo; \
    useradd --system --uid 10001 --gid pushgo --home-dir /nonexistent --shell /usr/sbin/nologin pushgo; \
    install -d -o pushgo -g pushgo /data /data/logs

WORKDIR /data

ENV PUSHGO_TOKEN= \
    PUSHGO_TOKEN_SERVICE_URL=https://token.pushgo.dev \
    PUSHGO_PRIVATE_TRANSPORTS=wss \
    PUSHGO_RUNTIME_PROFILE=small \
    PUSHGO_OBSERVABILITY_LOG_LEVEL=warn \
    PUSHGO_DB_URL=sqlite:///data/pushgo-gateway.sqlite \
    PUSHGO_MCP_ENABLED=false \
    PUSHGO_PUBLIC_BASE_URL= \
    PUSHGO_MCP_DCR_ENABLED=true \
    PUSHGO_MCP_PREDEFINED_CLIENTS= \
    PUSHGO_PRIVATE_TLS_CERT= \
    PUSHGO_PRIVATE_TLS_KEY= \
    PUSHGO_PRIVATE_QUIC_PORT=5223 \
    PUSHGO_PRIVATE_TCP_PORT=5223 \
    PUSHGO_MQTT_PORT=1883 \
    PUSHGO_MQTT_TLS_ENABLED=false \
    PUSHGO_MQTT_MAX_PACKET_BYTES=32768

RUN set -eux; \
    cat > /usr/local/bin/docker-entrypoint.sh <<'ENTRYPOINT_EOF'
#!/bin/sh
set -eu

export PUSHGO_SANDBOX_MODE="${PUSHGO_SANDBOX_MODE:-false}"
export PUSHGO_PRIVATE_TCP_TLS_ENABLED="${PUSHGO_PRIVATE_TCP_TLS_ENABLED:-false}"
export PUSHGO_PRIVATE_TCP_PROXY_PROTOCOL="${PUSHGO_PRIVATE_TCP_PROXY_PROTOCOL:-false}"
export PUSHGO_MCP_ACCESS_TOKEN_TTL_SECS="${PUSHGO_MCP_ACCESS_TOKEN_TTL_SECS:-900}"
export PUSHGO_MCP_REFRESH_TOKEN_ABSOLUTE_TTL_SECS="${PUSHGO_MCP_REFRESH_TOKEN_ABSOLUTE_TTL_SECS:-2592000}"
export PUSHGO_MCP_REFRESH_TOKEN_IDLE_TTL_SECS="${PUSHGO_MCP_REFRESH_TOKEN_IDLE_TTL_SECS:-604800}"
export PUSHGO_MCP_BIND_SESSION_TTL_SECS="${PUSHGO_MCP_BIND_SESSION_TTL_SECS:-600}"
export PUSHGO_HTTP_ADDR="${PUSHGO_HTTP_ADDR:-0.0.0.0:6666}"
export PUSHGO_PRIVATE_QUIC_BIND="${PUSHGO_PRIVATE_QUIC_BIND:-0.0.0.0:${PUSHGO_PRIVATE_QUIC_PORT:-5223}}"
export PUSHGO_PRIVATE_TCP_BIND="${PUSHGO_PRIVATE_TCP_BIND:-0.0.0.0:${PUSHGO_PRIVATE_TCP_PORT:-5223}}"
export PUSHGO_MQTT_BIND="${PUSHGO_MQTT_BIND:-0.0.0.0:${PUSHGO_MQTT_PORT:-1883}}"

if [ ! -w /data ]; then
  echo "/data is not writable" >&2
  exit 1
fi

exec /usr/local/bin/pushgo-gateway
ENTRYPOINT_EOF

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh

USER pushgo:pushgo
STOPSIGNAL SIGTERM

EXPOSE 6666/tcp
EXPOSE 5223/tcp
EXPOSE 5223/udp
EXPOSE 1883/tcp

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
